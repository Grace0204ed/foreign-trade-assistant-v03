{
  "name": "foreign-trade-assistant",
  "version": "0.7.1",
  "description": "外贸助手：客户跟进、产品、报价与外贸单证桌面系统",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "test": "node scripts/test-agency-documents.js && node scripts/test-history-actions.js && node scripts/test-procurement.js && node scripts/test-global-freight-calculator.cjs && node scripts/test-configurable-workspaces.cjs && node scripts/test-update-selection.cjs",
    "server": "node server/index.js",
    "electron": "electron .",
    "dev": "node server/index.js",
    "ensure:sqlite": "node scripts/ensure-node-sqlite.js",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "build:win": "electron-builder --win nsis",
    "check": "node --check server/index.js && node --check electron/main.js && node --check app.js && node --check crm/crm.js && node --check assets/global-freight-calculator.js && node --check assets/document-designer.js && node --check assets/configurable-workspaces.js && node --check assets/app-lock.js && node --check scripts/ensure-node-sqlite.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jinwanwa.foreigntradeassistant",
    "productName": "外贸助手",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "manifest.webmanifest",
      "app.js",
      "styles.css",
      "crm/**/*",
      "assets/**/*",
      "server/**/*",
      "!server/vehicle-quotes.js",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "assets/app-icon.ico",
      "artifactName": "Foreign-Trade-Assistant-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Grace0204ed",
        "repo": "foreign-trade-assistant-v03",
        "releaseType": "release"
      }
    ]
  }
}
